# Copy this file to .env.local and set your OpenRouter API key.
# Do NOT commit your real secret key to version control.

# Example:
# VITE_OPENROUTER_KEY="sk-<your_key_here>"
# MODEL can be set to openai/gpt-oss-20b:free or another available model on OpenRouter
# VITE_OPENROUTER_MODEL="openai/gpt-oss-20b:free"

VITE_OPENROUTER_KEY=
VITE_OPENROUTER_MODEL=openai/gpt-oss-20b:free
